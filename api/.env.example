# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=todo

# Observe Telemetry (https://observe.nestjs.com)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
OBSERVE_SERVICE_ID=todo-api

# JWT secrets for Authentication (must be different, 32+ random characters)
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_REFRESH_SECRET=your-different-secure-refresh-secret-here
